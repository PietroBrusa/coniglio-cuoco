{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "commonjs",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  // Senza questi, tsc raccoglie anche `test/` ed entra in conflitto con `rootDir`
  // (TS6059), rompendo `npm run typecheck`. `rootDir` non va toccato: lo eredita
  // tsconfig.build.json, e cambiarlo sposterebbe l'output in dist/src/.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}