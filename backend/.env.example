# Porta del server HTTP
PORT=3000

# Connessione MongoDB (locale o MongoDB Atlas)
# Locale:  mongodb://localhost:27017
# Atlas:   mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=coniglio_cuoco

# Origine consentita per il CORS (frontend Vite)
CORS_ORIGIN=http://localhost:5173

# Autenticazione JWT
# Obbligatoria: senza JWT_SECRET l'applicazione si rifiuta di avviarsi.
# Generane una casuale (e diversa per ogni ambiente) con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In produzione va impostata fra le variabili d'ambiente del servizio, mai in un file versionato.
JWT_SECRET=
JWT_EXPIRES=12h
